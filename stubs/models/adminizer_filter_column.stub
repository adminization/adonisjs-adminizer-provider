import { DateTime } from 'luxon'
import { BaseModel, column, belongsTo } from '@adonisjs/lucid/orm'
import type { BelongsTo } from '@adonisjs/lucid/types/relations'
import AdminizerFilter from './adminizer_filter.js'

export default class AdminizerFilterColumn extends BaseModel {
  static table = 'adminizer_filter_columns'

  @column({ isPrimary: true })
  declare id: number

  @column({ columnName: 'filter_id' })
  declare filterId: string

  @belongsTo(() => AdminizerFilter, {
    foreignKey: 'filterId',
  })
  declare filter: BelongsTo<typeof AdminizerFilter>

  @column({ columnName: 'field_name' })
  declare fieldName: string

  @column()
  declare order: number

  @column.dateTime({ autoCreate: true })
  declare createdAt: DateTime

  @column.dateTime({ autoCreate: true, autoUpdate: true })
  declare updatedAt: DateTime
}
